# Porta exposta no host
PORT=4000

# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Gere com: openssl rand -base64 48
JWT_SECRET=

# Usuario administrador criado automaticamente no primeiro start
# (so tem efeito se o banco ainda nao tiver nenhum usuario)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha

# Defina como "true" se for servir via HTTPS (recomendado em producao)
COOKIE_SECURE=false
